{
  "manifest_version": 3,
  "name": "Extensão Dark",
  "short_name": "Dark",
  "version": "0.6.2",
  "description": "Modo escuro local para sites. Leve, independente e sem rastreamento.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Extensão Dark",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/colors.js",
        "vendor/neural_core/neural-core.js",
        "content/neural.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
