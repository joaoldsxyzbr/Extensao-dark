{
  "manifest_version": 3,
  "name": "Extensão Dark",
  "short_name": "Dark",
  "version": "0.1.0",
  "description": "Modo escuro local para sites. Leve, independente e sem rastreamento.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Extensão Dark",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/colors.js", "content/content.js"],
      "run_at": "document_start"
    }
  ]
}
